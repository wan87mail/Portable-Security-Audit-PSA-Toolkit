{
  "format": "psa-baseline-1",
  "name": "Example Windows Workstation Baseline",
  "version": "1.0",
  "source": "Example organisational policy shipped with the Portable Security Audit toolkit (adapt before use)",
  "description": "Illustrative baseline for Windows 10/11 workstations, inspired by common Microsoft Security Baseline settings. Review every rule against your own policy before importing it.",
  "applies_to": {"os_family": "windows"},
  "rules": [
    {"id": "UAC-01", "title": "User Account Control is enabled", "severity": "high",
     "check": {"type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
               "name": "EnableLUA", "default": 1},
     "expected": {"op": "eq", "value": 1}},
    {"id": "UAC-02", "title": "Administrators are prompted for consent on the secure desktop", "severity": "medium",
     "check": {"type": "registry", "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
               "name": "ConsentPromptBehaviorAdmin", "default": 5},
     "expected": {"op": "in", "value": [1, 2]},
     "remediation": "Group Policy: 'User Account Control: Behavior of the elevation prompt for administrators' = Prompt for consent on the secure desktop."},
    {"id": "LSA-01", "title": "Only NTLMv2 is sent; LM and NTLM are refused", "severity": "medium",
     "check": {"type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
               "name": "LmCompatibilityLevel", "default": 3},
     "expected": {"op": "eq", "value": 5}},
    {"id": "LSA-02", "title": "WDigest does not store plaintext credentials", "severity": "high",
     "check": {"type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\WDigest",
               "name": "UseLogonCredential", "default": 0},
     "expected": {"op": "eq", "value": 0}},
    {"id": "LSA-03", "title": "LSA protection is enabled", "severity": "low",
     "check": {"type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RunAsPPL"},
     "expected": {"op": "in", "value": [1, 2]}},
    {"id": "SMB-01", "title": "SMB server requires signing", "severity": "medium",
     "check": {"type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
               "name": "RequireSecuritySignature", "default": 0},
     "expected": {"op": "eq", "value": 1}},
    {"id": "SMB-02", "title": "SMB client requires signing", "severity": "low",
     "check": {"type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
               "name": "RequireSecuritySignature", "default": 0},
     "expected": {"op": "eq", "value": 1}},
    {"id": "RDP-01", "title": "Remote Desktop is disabled on workstations", "severity": "medium",
     "check": {"type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server",
               "name": "fDenyTSConnections", "default": 1},
     "expected": {"op": "eq", "value": 1}},
    {"id": "DNS-01", "title": "LLMNR is disabled", "severity": "low",
     "check": {"type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
               "name": "EnableMulticast"},
     "expected": {"op": "eq", "value": 0}},
    {"id": "FW-01", "title": "Group Policy does not disable the domain firewall profile", "severity": "high",
     "check": {"type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile",
               "name": "EnableFirewall"},
     "expected": {"op": "ne", "value": 0}},
    {"id": "AV-01", "title": "Group Policy does not disable Microsoft Defender", "severity": "high",
     "check": {"type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender",
               "name": "DisableAntiSpyware"},
     "expected": {"op": "ne", "value": 1}},
    {"id": "ACC-01", "title": "Minimum password length is at least 14", "severity": "medium",
     "check": {"type": "net_accounts", "key": "min_length"}, "expected": {"op": "ge", "value": 14}},
    {"id": "ACC-02", "title": "Account lockout is configured", "severity": "medium",
     "check": {"type": "net_accounts", "key": "lockout_threshold"}, "expected": {"op": "ge", "value": 1}},
    {"id": "ACC-03", "title": "Account lockout threshold is 10 or fewer attempts", "severity": "low",
     "check": {"type": "net_accounts", "key": "lockout_threshold"}, "expected": {"op": "le", "value": 10}},
    {"id": "ACC-04", "title": "Password history remembers 24 passwords", "severity": "low",
     "check": {"type": "net_accounts", "key": "history"}, "expected": {"op": "ge", "value": 24}},
    {"id": "SVC-01", "title": "Remote Registry does not start automatically", "severity": "low",
     "check": {"type": "windows_service", "name": "RemoteRegistry", "property": "start_type"},
     "expected": {"op": "not_in", "value": ["Automatic"]}},
    {"id": "SVC-02", "title": "Telnet server is not installed", "severity": "high",
     "check": {"type": "windows_service", "name": "TlntSvr", "property": "start_type"},
     "expected": {"op": "absent"}},
    {"id": "AUD-01", "title": "Logon events are audited (success and failure)", "severity": "medium",
     "check": {"type": "auditpol", "guid": "{0CCE9215-69AE-11D9-BED3-505054503030}"},
     "expected": {"op": "eq", "value": 3}},
    {"id": "AUD-02", "title": "Credential validation is audited (success and failure)", "severity": "medium",
     "check": {"type": "auditpol", "guid": "{0CCE923F-69AE-11D9-BED3-505054503030}"},
     "expected": {"op": "eq", "value": 3}},
    {"id": "AUD-03", "title": "Process creation is audited", "severity": "low",
     "check": {"type": "auditpol", "guid": "{0CCE922B-69AE-11D9-BED3-505054503030}"},
     "expected": {"op": "in", "value": [1, 3]}}
  ]
}
