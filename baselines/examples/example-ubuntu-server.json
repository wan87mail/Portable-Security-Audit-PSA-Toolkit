{
  "format": "psa-baseline-1",
  "name": "Example Ubuntu Server Baseline",
  "version": "1.0",
  "source": "Example organisational policy shipped with the Portable Security Audit toolkit (adapt before use)",
  "description": "Illustrative baseline for Ubuntu 22.04/24.04 servers. Review every rule against your own policy before importing it.",
  "applies_to": {"os_family": "linux", "distro": ["ubuntu"]},
  "rules": [
    {"id": "SSH-01", "title": "SSH root login is disabled", "severity": "high",
     "check": {"type": "sshd", "key": "permitrootlogin", "default": "prohibit-password"},
     "expected": {"op": "in", "value": ["no", "prohibit-password"]},
     "rationale": "Direct root login removes individual accountability and exposes the most privileged account.",
     "remediation": "Set 'PermitRootLogin no' in /etc/ssh/sshd_config.d/ and reload sshd."},
    {"id": "SSH-02", "title": "SSH password authentication is disabled", "severity": "medium",
     "check": {"type": "sshd", "key": "passwordauthentication", "default": "yes"},
     "expected": {"op": "eq", "value": "no"},
     "rationale": "Key-based authentication resists password guessing and credential stuffing.",
     "remediation": "Deploy SSH keys, then set 'PasswordAuthentication no' and reload sshd."},
    {"id": "SSH-03", "title": "SSH does not allow empty passwords", "severity": "critical",
     "check": {"type": "sshd", "key": "permitemptypasswords", "default": "no"},
     "expected": {"op": "eq", "value": "no"},
     "remediation": "Set 'PermitEmptyPasswords no' and reload sshd."},
    {"id": "SSH-04", "title": "SSH X11 forwarding is disabled", "severity": "low",
     "check": {"type": "sshd", "key": "x11forwarding", "default": "no"},
     "expected": {"op": "eq", "value": "no"}, "remediation": "Set 'X11Forwarding no'."},
    {"id": "SSH-05", "title": "SSH allows at most 4 authentication attempts", "severity": "low",
     "check": {"type": "sshd", "key": "maxauthtries", "default": "6"},
     "expected": {"op": "le", "value": 4}, "remediation": "Set 'MaxAuthTries 4'."},
    {"id": "KRN-01", "title": "Full address space layout randomization is enabled", "severity": "high",
     "check": {"type": "sysctl", "name": "kernel.randomize_va_space"},
     "expected": {"op": "eq", "value": 2},
     "remediation": "Set kernel.randomize_va_space = 2 in /etc/sysctl.d/99-baseline.conf."},
    {"id": "KRN-02", "title": "Source-routed packets are rejected", "severity": "medium",
     "check": {"type": "sysctl", "name": "net.ipv4.conf.all.accept_source_route"},
     "expected": {"op": "eq", "value": 0}},
    {"id": "KRN-03", "title": "Symlink protection is enabled", "severity": "low",
     "check": {"type": "sysctl", "name": "fs.protected_symlinks"}, "expected": {"op": "eq", "value": 1}},
    {"id": "KRN-04", "title": "TCP SYN cookies are enabled", "severity": "low",
     "check": {"type": "sysctl", "name": "net.ipv4.tcp_syncookies"}, "expected": {"op": "eq", "value": 1}},
    {"id": "ACC-01", "title": "Passwords are hashed with SHA-512 or yescrypt", "severity": "medium",
     "check": {"type": "file_kv", "path": "/etc/login.defs", "key": "ENCRYPT_METHOD", "default": "SHA512"},
     "expected": {"op": "in", "value": ["SHA512", "YESCRYPT"]}},
    {"id": "ACC-02", "title": "Default umask is 027 or stricter", "severity": "low",
     "check": {"type": "file_kv", "path": "/etc/login.defs", "key": "UMASK", "default": "022"},
     "expected": {"op": "in", "value": ["027", "077"]},
     "rationale": "A restrictive umask prevents new files from being readable by other users.",
     "remediation": "Set 'UMASK 027' in /etc/login.defs."},
    {"id": "FILE-01", "title": "/etc/passwd is owned by root and not writable by others", "severity": "high",
     "check": {"type": "file_mode", "path": "/etc/passwd", "owner_uid": 0},
     "expected": {"op": "mode_max", "value": "0644"}},
    {"id": "FILE-02", "title": "/etc/shadow is not readable by other users", "severity": "critical",
     "check": {"type": "file_mode", "path": "/etc/shadow", "owner_uid": 0},
     "expected": {"op": "mode_max", "value": "0640"}},
    {"id": "FILE-03", "title": "/etc/crontab is accessible only by root", "severity": "low",
     "check": {"type": "file_mode", "path": "/etc/crontab", "owner_uid": 0},
     "expected": {"op": "mode_max", "value": "0600"}, "remediation": "sudo chmod 600 /etc/crontab"},
    {"id": "PKG-01", "title": "Telnet server is not installed", "severity": "high",
     "check": {"type": "package", "name": "telnetd"}, "expected": {"op": "absent"},
     "remediation": "sudo apt purge telnetd"},
    {"id": "PKG-02", "title": "NIS server is not installed", "severity": "high",
     "check": {"type": "package", "name": "nis"}, "expected": {"op": "absent"}},
    {"id": "PKG-03", "title": "Automatic security updates are installed", "severity": "medium",
     "check": {"type": "package", "name": "unattended-upgrades"}, "expected": {"op": "exists"},
     "remediation": "sudo apt install unattended-upgrades"},
    {"id": "UPD-01", "title": "Automatic security updates are enabled", "severity": "medium",
     "check": {"type": "file_contains", "path": "/etc/apt/apt.conf.d/20auto-upgrades",
               "text": "Unattended-Upgrade \"1\""},
     "expected": {"op": "eq", "value": true},
     "remediation": "sudo dpkg-reconfigure -plow unattended-upgrades"},
    {"id": "SVC-01", "title": "The ufw firewall service is enabled", "severity": "medium",
     "check": {"type": "service", "unit": "ufw", "property": "enabled"},
     "expected": {"op": "eq", "value": "enabled"}},
    {"id": "SVC-02", "title": "AppArmor is active", "severity": "medium",
     "check": {"type": "service", "unit": "apparmor", "property": "active"},
     "expected": {"op": "eq", "value": "active"}},
    {"id": "SVC-03", "title": "Avahi (mDNS) is not enabled on servers", "severity": "low",
     "check": {"type": "service", "unit": "avahi-daemon", "property": "enabled"},
     "expected": {"op": "not_in", "value": ["enabled"]},
     "remediation": "sudo systemctl disable --now avahi-daemon"}
  ]
}
